* text=auto

# Preserve imported reference inputs byte-for-byte without EOL rewriting.
inputs/reference_model/model/**/*.v              -text
inputs/reference_model/weights/*.mif              -text
inputs/reference_model/biases/*.mif               -text
inputs/reference_model/activation/*.mif           -text
inputs/reference_model/testdata/*.txt              -text

*.sv    text eol=lf
*.svh   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.tcl   text eol=lf
*.do    text eol=lf

# Preserve the supplied Systolic Controller RTL after the generic SV rule.
inputs/systolic_controller/rtl/*.sv                -text

*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.wlf   binary
*.vcd   binary

